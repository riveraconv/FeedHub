<?xml version="1.0" encoding="utf-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ================================= -->
    <!-- STATUS MESSAGE - CONTAINER        -->
    <!-- ================================= -->

    <Style x:Key="StatusMessageContainerStyle"
           TargetType="Border">

        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding
                    Light={StaticResource FeedHubLightSurface},
                    Dark={StaticResource FeedHubDarkSurface}}" />

        <Setter Property="Stroke"
                Value="{AppThemeBinding
                    Light={StaticResource FeedHubLightBorder},
                    Dark={StaticResource FeedHubDarkBorder}}" />

        <Setter Property="StrokeThickness"
                Value="1" />

        <Setter Property="Padding"
                Value="24" />

        <Setter Property="Margin"
                Value="24" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18" />
            </Setter.Value>
        </Setter>

    </Style>


    <!-- ================================= -->
    <!-- STATUS MESSAGE - ICON             -->
    <!-- ================================= -->

    <Style x:Key="StatusMessageIconStyle"
           TargetType="Label">

        <Setter Property="FontSize"
                Value="42" />

        <Setter Property="HorizontalOptions"
                Value="Center" />

        <Setter Property="HorizontalTextAlignment"
                Value="Center" />

        <Setter Property="TextColor"
                Value="{AppThemeBinding
                    Light={StaticResource FeedHubLightAccent},
                    Dark={StaticResource FeedHubDarkAccent}}" />

    </Style>


    <!-- ================================= -->
    <!-- STATUS MESSAGE - TITLE            -->
    <!-- ================================= -->

    <Style x:Key="StatusMessageTitleStyle"
           TargetType="Label">

        <Setter Property="FontSize"
                Value="20" />

        <Setter Property="FontAttributes"
                Value="Bold" />

        <Setter Property="HorizontalOptions"
                Value="Center" />

        <Setter Property="HorizontalTextAlignment"
                Value="Center" />

        <Setter Property="TextColor"
                Value="{AppThemeBinding
                    Light={StaticResource FeedHubLightTextPrimary},
                    Dark={StaticResource FeedHubDarkTextPrimary}}" />

    </Style>


    <!-- ================================= -->
    <!-- STATUS MESSAGE - DESCRIPTION     -->
    <!-- ================================= -->

    <Style x:Key="StatusMessageDescriptionStyle"
           TargetType="Label">

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="LineHeight"
                Value="1.3" />

        <Setter Property="HorizontalOptions"
                Value="Center" />

        <Setter Property="HorizontalTextAlignment"
                Value="Center" />

        <Setter Property="TextColor"
                Value="{AppThemeBinding
                    Light={StaticResource FeedHubLightTextSecondary},
                    Dark={StaticResource FeedHubDarkTextSecondary}}" />

    </Style>


    <!-- ================================= -->
    <!-- STATUS MESSAGE - BUTTON           -->
    <!-- ================================= -->

    <Style x:Key="StatusMessageButtonStyle"
           TargetType="Button">

        <Setter Property="CornerRadius"
                Value="12" />

        <Setter Property="Padding"
                Value="20,10" />

        <Setter Property="FontAttributes"
                Value="Bold" />

        <Setter Property="HorizontalOptions"
                Value="Center" />

        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding
                    Light={StaticResource FeedHubLightMainBlue},
                    Dark={StaticResource FeedHubDarkMainBlue}}" />

        <Setter Property="TextColor"
                Value="#FFFFFF" />

    </Style>

</ResourceDictionary>