<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FeedHub_App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FeedHub_App.Views"
    xmlns:news="clr-namespace:FeedHub_App.Views.News"
    xmlns:settings="clr-namespace:FeedHub_App.Views.Settings"
    Title="FeedHub_App">

    <ShellContent
        Title="Home" ContentTemplate="{DataTemplate views:MainPage}" Route="MainPage" />
    <ShellContent
        Title="LatestNews" ContentTemplate="{DataTemplate news:LatestNewsPage}" Route="LatestNewsPage" />
    <ShellContent
        Title="Explore" ContentTemplate="{DataTemplate news:ExplorePage}" Route="ExplorePage" />
    <ShellContent
        Title="Settings" ContentTemplate="{DataTemplate settings:SettingsPage}" Route="SettingsPage" />
</Shell>


    