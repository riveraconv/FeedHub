<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeedHub_App.Views.Controls.NewsItemView">

    <Border Stroke="Gray" StrokeThickness="1" Padding="10">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10"/>
        </Border.StrokeShape>

        <VerticalStackLayout>
            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16"/>
            <Label Text="{Binding Summary}" FontSize="14" LineBreakMode="TailTruncation"/>
        </VerticalStackLayout>
    </Border>

</ContentView>

