<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FeedHub_App.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FeedHub_App.Views.AboutPage"
             x:DataType="vm:AboutViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightBackground}, Dark={StaticResource FeedHubDarkBackground}}">

    <ContentPage.Behaviors>
            <toolkit:StatusBarBehavior StatusBarColor="Transparent" 
                                   StatusBarStyle="{AppThemeBinding Light=DarkContent,Dark=LightContent}" />
        </ContentPage.Behaviors>

    <Grid IgnoreSafeArea="True">
                    <!-- GRADIENTE LIGHT -->
                <BoxView
                    IsEnabled="False"
                    InputTransparent="True"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    IsVisible="{AppThemeBinding Light=True, Dark=False}">

                    <BoxView.Background>
                        <RadialGradientBrush Center="0.82,0.12" Radius="0.85">
                            <GradientStop Color="#BFE3FF" Offset="0.0" />
                            <GradientStop Color="#EAF5FF" Offset="0.35" />
                            <GradientStop Color="#F4F8FC" Offset="1.0" />
                        </RadialGradientBrush>
                    </BoxView.Background>
                </BoxView>


                <!-- GRADIENTE DARK -->
                <BoxView
                    IsEnabled="False"
                    InputTransparent="True"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    IsVisible="{AppThemeBinding Light=False, Dark=True}">

                    <BoxView.Background>
                        <RadialGradientBrush Center="0.8,0.2" Radius="0.8">
                            <GradientStop Color="#2638BDF8" Offset="0.1" />
                            <GradientStop Color="#101E32" Offset="0.45" />
                            <GradientStop Color="#141414" Offset="1.0" />
                        </RadialGradientBrush>
                    </BoxView.Background>
            </BoxView>

        <Grid RowDefinitions="Auto, Auto, *" Padding="0,45,0,0">

            <!-- HEADER -->
            <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="25,10,25,20">
                <Label Text="FEEDHUB" TextColor="{AppThemeBinding Light={StaticResource FeedHubLightMainBlue}, Dark={StaticResource FeedHubDarkAccent}}"
                       FontSize="12" FontAttributes="Bold" CharacterSpacing="2"/>
                <Label Text="Acerca de" TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary}, Dark={StaticResource FeedHubDarkTextPrimary}}"
                       FontSize="32" FontAttributes="Bold"/>
                <BoxView HeightRequest="3" BackgroundColor= "{AppThemeBinding Light={StaticResource FeedHubLightAccent}, Dark={StaticResource FeedHubDarkAccent}}"
                         WidthRequest="40" HorizontalOptions="Start" Margin="0,8,0,0"/>
            </VerticalStackLayout>

            <!-- TABS -->
            <Border Grid.Row="1" Margin="25,0,25,10" Padding="4"
                    BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightSurfaceSecondary}, Dark={StaticResource FeedHubDarkSurface}}"
                    Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder}, Dark={StaticResource FeedHubDarkCardBorder}}"
                    StrokeShape="RoundRectangle 25" StrokeThickness="2">
                <Grid ColumnDefinitions="*,*">
                    <Button Text="LA APP"
                            Command="{Binding ChangeTabCommand}" CommandParameter="app"
                            CornerRadius="22" HeightRequest="45" FontSize="12" FontAttributes="Bold">
                        <Button.Triggers>
                            <!-- SELECCIONADA -->
                            <DataTrigger TargetType="Button" Binding="{Binding ShowApp}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FeedHubLightAccent},Dark={StaticResource FeedHubDarkAccent}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FeedHubLightSurface},Dark={StaticResource FeedHubDarkTextPrimary}}" />
                            </DataTrigger>
                            <!-- NO SELECCIONADA -->
                            <DataTrigger TargetType="Button" Binding="{Binding ShowApp}" Value="False">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary},Dark={StaticResource FeedHubDarkTextSecondary}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="LEGAL"
                            Command="{Binding ChangeTabCommand}" CommandParameter="legal"
                            CornerRadius="22" HeightRequest="45" FontSize="12" FontAttributes="Bold">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowApp}" Value="False">
                                <!-- SELECCIONADA -->
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource FeedHubLightAccent},Dark={StaticResource FeedHubDarkAccent}}" />
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource FeedHubLightSurface},Dark={StaticResource FeedHubDarkTextPrimary}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowApp}" Value="True">
                                <!-- NO SELECCIONADA -->
                                <Setter Property="BackgroundColor"
                                        Value="Transparent" />
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary}, Dark={StaticResource FeedHubDarkTextSecondary}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <ScrollView Grid.Row="2" Padding="25,10,25,40">
                <VerticalStackLayout Spacing="16">

                    <!-- PESTAÑA LA APP -->
                    <VerticalStackLayout IsVisible="{Binding ShowApp}" Spacing="16">

                        <Border StrokeShape="RoundRectangle 20" 
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},Dark={StaticResource FeedHubDarkCard}}" 
                                StrokeThickness="1" Padding="20">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="¿Qué es FeedHub?" TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent},Dark={StaticResource FeedHubDarkAccent}}" FontSize="13" FontAttributes="Bold"/>
                                <Label TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary}, Dark={StaticResource FeedHubDarkTextPrimary}}"
                                       FontSize="14" LineBreakMode="WordWrap">
                                    <Label.Text>FeedHub es un agregador de noticias que reúne contenido de distintos medios españoles e internacionales en una sola aplicación. El contenido procede de sus respectivas fuentes y FeedHub actúa únicamente como lector y agregador, sin modificar ni atribuirse la autoría del contenido de terceros.</Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeShape="RoundRectangle 20" 
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},Dark={StaticResource FeedHubDarkCard}}"
                                StrokeThickness="1" Padding="20">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Contenido externo" TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent},Dark={StaticResource FeedHubDarkAccent}}" FontSize="13" FontAttributes="Bold"/>
                                <Label TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary}, Dark={StaticResource FeedHubDarkTextPrimary}}" FontSize="14" LineBreakMode="WordWrap">
                                    <Label.Text>FeedHub obtiene contenido de fuentes RSS y de los sitios web de los medios originales. La disponibilidad, formato y contenido de estos servicios dependen de sus respectivos operadores, por lo que algunos artículos pueden no cargarse correctamente o mostrarse de forma incompleta.</Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeShape="RoundRectangle 20" 
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},Dark={StaticResource FeedHubDarkCard}}" 
                                StrokeThickness="1" Padding="20">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Publicidad" TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent},Dark={StaticResource FeedHubDarkAccent}}" FontSize="13" FontAttributes="Bold"/>
                                <Label TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary}, Dark={StaticResource FeedHubDarkTextPrimary}}" FontSize="14" LineBreakMode="WordWrap">
                                    <Label.Text>FeedHub puede incorporar publicidad para contribuir al mantenimiento y desarrollo de la aplicación y mantener su acceso gratuito. Cualquier servicio publicitario de terceros se indicará en la correspondiente política de privacidad.</Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeShape="RoundRectangle 20" 
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},Dark={StaticResource FeedHubDarkCard}}"
                                StrokeThickness="1" Padding="20">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Proyecto en desarrollo" TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent},Dark={StaticResource FeedHubDarkAccent}}" FontSize="13" FontAttributes="Bold"/>
                                <Label TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary}, Dark={StaticResource FeedHubDarkTextPrimary}}" FontSize="14" LineBreakMode="WordWrap">
                                    <Label.Text>FeedHub es un proyecto personal en desarrollo continuo. La aplicación puede recibir mejoras, cambios y correcciones con el tiempo.</Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!-- PESTAÑA LEGAL -->
                    <VerticalStackLayout IsVisible="{Binding ShowApp, Converter={toolkit:InvertedBoolConverter}}" Spacing="16">

                        <Border StrokeShape="RoundRectangle 20"
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},Dark={StaticResource FeedHubDarkCard}}"
                                StrokeThickness="1" Padding="20">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Política de Privacidad" TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent},Dark={StaticResource FeedHubDarkAccent}}" FontSize="13" FontAttributes="Bold"/>
                                <Label TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary}, Dark={StaticResource FeedHubDarkTextPrimary}}" FontSize="14" LineBreakMode="WordWrap">
                                    <Label.Text>FeedHub no recopila, almacena ni comparte datos personales del usuario. La aplicación no requiere una cuenta ni un registro para utilizar sus funciones principales. FeedHub únicamente almacena de forma local determinadas preferencias de funcionamiento, como el tema visual seleccionado y las fuentes o categorías desactivadas. Estas preferencias permanecen en el dispositivo y no se envían a servidores de FeedHub. Además, FeedHub utiliza una caché temporal en memoria para mejorar la carga de artículos. Esta caché contiene únicamente información del contenido de las noticias y no datos personales del usuario. Las entradas tienen una duración máxima de 30 minutos y también pueden eliminarse manualmente desde Ajustes.</Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeShape="RoundRectangle 20" 
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},Dark={StaticResource FeedHubDarkCard}}"
                                StrokeThickness="1" Padding="20">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Publicidad y datos" TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent},Dark={StaticResource FeedHubDarkAccent}}" FontSize="13" FontAttributes="Bold"/>
                                <Label TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary}, Dark={StaticResource FeedHubDarkTextPrimary}}" FontSize="14" LineBreakMode="WordWrap">
                                    <Label.Text>Actualmente, FeedHub no incorpora ningún sistema propio de analítica, seguimiento o recopilación de datos personales. La aplicación podrá utilizar servicios publicitarios de terceros para mostrar anuncios. En ese caso, dichos proveedores podrán tratar determinados datos técnicos y identificadores de acuerdo con sus propias políticas de privacidad y las opciones de consentimiento aplicables. Esta información se detallará en la presente sección cuando dichos servicios sean incorporados.</Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeShape="RoundRectangle 20"
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},Dark={StaticResource FeedHubDarkCard}}"
                                StrokeThickness="1" Padding="20">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Contenido de terceros" TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent},Dark={StaticResource FeedHubDarkAccent}}" FontSize="13" FontAttributes="Bold"/>
                                <Label TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary}, Dark={StaticResource FeedHubDarkTextPrimary}}" FontSize="14" LineBreakMode="WordWrap">
                                    <Label.Text>FeedHub se conecta a servidores y sitios web de terceros para obtener y mostrar contenido de noticias. Estos operadores pueden registrar y tratar información técnica asociada a las conexiones, como direcciones IP, conforme a sus propias políticas de privacidad, cookies y condiciones de uso. Una vez que el usuario accede directamente a un sitio web externo, cualquier tratamiento de datos realizado por dicho operador queda sujeto a sus propias políticas.</Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeShape="RoundRectangle 20"
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},Dark={StaticResource FeedHubDarkCard}}"
                                StrokeThickness="1" Padding="20">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Recopilación de datos" TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent},Dark={StaticResource FeedHubDarkAccent}}" FontSize="13" FontAttributes="Bold"/>
                                <Label TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary}, Dark={StaticResource FeedHubDarkTextPrimary}}" FontSize="14" LineBreakMode="WordWrap">
                                    <Label.Text>FeedHub no recopila datos personales del usuario para su propio uso. No se requiere proporcionar nombre, correo electrónico, número de teléfono, ubicación ni crear una cuenta para utilizar la aplicación. La aplicación puede almacenar localmente preferencias y datos temporales relacionados con el funcionamiento y la visualización de noticias, pero estos datos no se utilizan para crear perfiles personales ni se transmiten a servidores de FeedHub.</Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>