<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FeedHub_App.ViewModels.Settings"
             x:Class="FeedHub_App.Views.Settings.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False">

    <Grid IgnoreSafeArea="True">
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D253F" Offset="0.1" />
                    <GradientStop Color="#813B83F6" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto, *" Padding="25">
            
            <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,10,0,30">
                <Label Text="AJUSTES" 
                       TextColor="#4FC3F7" 
                       FontSize="12" 
                       FontAttributes="Bold" 
                       CharacterSpacing="2"/>
                <Label Text="Configuración" 
                       TextColor="White" 
                       FontSize="32" 
                       FontAttributes="Bold"/>
                <BoxView HeightRequest="1" 
                         BackgroundColor="#1A3A5A" 
                         WidthRequest="100" 
                         HorizontalOptions="Start"/>
            </VerticalStackLayout>

            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="15">
                    
                    <Border Stroke="#1E3A5A"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="#0F253E"
                            Padding="20">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Modo oscuro" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="Forzar tema oscuro para la aplicación" FontSize="13" TextColor="#8A99A8" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" 
                                    IsToggled="{Binding IsDarkMode}"
                                    OnColor="#4FC3F7"
                                    ThumbColor="White" />
                        </Grid>
                    </Border>

                    <Border Stroke="#1E3A5A"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="#0F253E"
                            Padding="20">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Limpiar Caché" FontSize="18" FontAttributes="Bold" TextColor="White" />
                                <Label Text="Borra temporalmente los datos" FontSize="13" TextColor="#8A99A8" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" 
                                    Command="{Binding ClearCacheCommand}"
                                    Text="LIMPIAR"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    HeightRequest="40"
                                    WidthRequest="100"
                                    CornerRadius="20"
                                    BackgroundColor="#1A3A5A"
                                    TextColor="#4FC3F7" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>