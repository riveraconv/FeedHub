<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FeedHub_App.ViewModels.Settings"
             x:Class="FeedHub_App.Views.Settings.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.PresentationMode="ModalAnimated"
             Title="Settings">

    <Grid RowDefinitions="*, Auto" Padding="25">

        <VerticalStackLayout Grid.Row="0" Spacing="20">
            <Label 
                Text="Configuration"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                Margin="0,20,0,10"/>

            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Dark Mode" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Force dark theme for the app" FontSize="12" Opacity="0.6" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" 
                        IsToggled="{Binding IsDarkMode}" 
                        OnColor="Black" 
                        ThumbColor="White" />
            </Grid>

            <BoxView HeightRequest="1" Color="Gray" Opacity="0.2" />

            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Clear Cache" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Delete temporary images and news" FontSize="12" Opacity="0.6" />
                </VerticalStackLayout>
                <Button Grid.Column="1" 
                        Command="{Binding ClearCacheCommand}"
                        Text="Clean"
                        FontSize="12"
                        HeightRequest="40"
                        CornerRadius="20"
                        BackgroundColor="{AppThemeBinding Light=Black, Dark=#333333}"
                        TextColor="White" />
            </Grid>
        </VerticalStackLayout>

        <Border Grid.Row="1"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,10,10"
                HeightRequest="55"
                WidthRequest="55"
                StrokeShape="RoundRectangle 15"
                BackgroundColor="Transparent"
                Stroke="#383838"
                StrokeThickness="2">

            <Grid>
                <Button Command="{Binding GoBackToMainMenuCommand}"
                        BackgroundColor="Black"
                        CornerRadius="12"
                        Opacity="0.6"/>

                <Label Text="↩" 
                       TextColor="White"
                       FontSize="32"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       InputTransparent="True"
                       Margin="0,-4,0,0"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>