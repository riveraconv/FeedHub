<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FeedHub_App.ViewModels.Settings"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FeedHub_App.Views.Settings.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightBackground}, Dark={StaticResource FeedHubDarkBackground}}">

        <ContentPage.Behaviors>
            <toolkit:StatusBarBehavior StatusBarColor="Transparent" 
                                   StatusBarStyle="{AppThemeBinding Light=DarkContent,Dark=LightContent}" />
        </ContentPage.Behaviors>

    <Grid IgnoreSafeArea="True">
                    <!-- GRADIENTE LIGHT -->
                <BoxView
                    IsEnabled="False"
                    InputTransparent="True"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    IsVisible="{AppThemeBinding Light=True, Dark=False}">

                    <BoxView.Background>
                        <RadialGradientBrush Center="0.82,0.12" Radius="0.85">
                            <GradientStop Color="#BFE3FF" Offset="0.0" />
                            <GradientStop Color="#EAF5FF" Offset="0.35" />
                            <GradientStop Color="#F4F8FC" Offset="1.0" />
                        </RadialGradientBrush>
                    </BoxView.Background>
                </BoxView>


                <!-- GRADIENTE DARK -->
                <BoxView
                    IsEnabled="False"
                    InputTransparent="True"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    IsVisible="{AppThemeBinding Light=False, Dark=True}">

                    <BoxView.Background>
                        <RadialGradientBrush Center="0.8,0.2" Radius="0.8">
                            <GradientStop Color="#2638BDF8" Offset="0.1" />
                            <GradientStop Color="#101E32" Offset="0.45" />
                            <GradientStop Color="#141414" Offset="1.0" />
                        </RadialGradientBrush>
                    </BoxView.Background>
            </BoxView>

        <Grid RowDefinitions="Auto, *" Padding="0,45,0,0">
            
            <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="25,10,25,20">
                <Label  Text="AJUSTES"
                        TextColor="{AppThemeBinding Light={StaticResource FeedHubLightMainBlue}, Dark={StaticResource FeedHubDarkAccent}}"
                        FontSize="12" FontAttributes="Bold" CharacterSpacing="2"/>
                <Label  Text="Configuración"
                        TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary}, Dark={StaticResource FeedHubDarkTextPrimary}}"
                        FontSize="32" FontAttributes="Bold"/>
                <BoxView HeightRequest="3"
                         BackgroundColor= "{AppThemeBinding Light={StaticResource FeedHubLightAccent}, Dark={StaticResource FeedHubDarkAccent}}"
                         WidthRequest="40" HorizontalOptions="Start" Margin="0,8,0,0"/>
            </VerticalStackLayout>

            <Grid Grid.Row="1" RowDefinitions="*, Auto" Padding="25,10,25,20">
                <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Grid.Row="0" Spacing="15">
                    
                    <Border StrokeThickness="1"
                            StrokeShape="RoundRectangle 24"
                            Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                        Dark={StaticResource FeedHubDarkCardBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},
                                    Dark={StaticResource FeedHubDarkCard}}"
                            Padding="20">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Modo oscuro" FontSize="18" FontAttributes="Bold" 
                                        TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary},
                                                    Dark={StaticResource FeedHubDarkTextPrimary}}"/>
                                <Label Text="Forzar tema oscuro para la vista rápida" FontSize="13" 
                                       TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary},
                                                                            Dark={StaticResource FeedHubDarkTextSecondary}}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" 
                                    IsToggled="{Binding IsDarkMode}"
                                    OnColor="#38BDF8"
                                    ThumbColor="White" />
                        </Grid>
                    </Border>

                    <Border StrokeThickness="1"
                            StrokeShape="RoundRectangle 24"
                            Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                        Dark={StaticResource FeedHubDarkCardBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},
                                        Dark={StaticResource FeedHubDarkCard}}"
                            Padding="20">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Limpiar Caché" FontSize="18" FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary},
                                                    Dark={StaticResource FeedHubDarkTextPrimary}}" />
                                <Label Text="Borra temporalmente los datos locales" FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary},
                                                                            Dark={StaticResource FeedHubDarkTextSecondary}}"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" 
                                    Command="{Binding ClearCacheCommand}"
                                    Text="LIMPIAR"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    HeightRequest="40"
                                    WidthRequest="100"
                                    CornerRadius="20"
                                    Background="{AppThemeBinding Light={StaticResource FeedHubLightAccentSoft},
                                            Dark={StaticResource FeedHubDarkAccentSoft}}"
                                    TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent},
                                                Dark={StaticResource FeedHubDarkAccent}}"/>
                        </Grid>
                    </Border>

                    <Border StrokeThickness="1"
                            StrokeShape="RoundRectangle 24"
                            Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                        Dark={StaticResource FeedHubDarkCardBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},
                                        Dark={StaticResource FeedHubDarkCard}}"
                            Padding="20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToFiltersCommand}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Personalizar contenido" FontSize="18" FontAttributes="Bold" 
                                        TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary},
                                                    Dark={StaticResource FeedHubDarkTextPrimary}}"/>
                                <Label Text="Filtra tus categorías o medios preferidos" FontSize="13"
                                        TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary},
                                                                            Dark={StaticResource FeedHubDarkTextSecondary}}"/>
                            </VerticalStackLayout>
                            
                            <Label Grid.Column="1" 
                                Text="→" 
                                TextColor="#38BDF8" 
                                FontSize="22" 
                                VerticalOptions="Center" 
                                Margin="10,0,10,0"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
            
                <Label Grid.Row="1" 
                        Text="{Binding AppVersion}" 
                        TextColor="#475569" 
                        FontSize="12" 
                        HorizontalOptions="Start"
                        VerticalOptions="End"
                        Margin="0,0,0,30"/>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>