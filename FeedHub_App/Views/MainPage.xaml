<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FeedHub_App.ViewModels"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
    x:DataType="vm:MainViewModel"
    x:Class="FeedHub_App.Views.MainPage">

<Grid RowDefinitions="*, Auto">
    <BoxView Grid.RowSpan="2">
        <BoxView.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D253F" Offset="0.1" />
                <GradientStop Color="#813B83F6" Offset="1.0" />
            </LinearGradientBrush>
        </BoxView.Background>
    </BoxView>

    <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="25" Spacing="16">
            
            <VerticalStackLayout>
                <Label Text="FeedHub" FontSize="48" FontAttributes="Bold" TextColor="White" Margin="0,10,0,0"/>
                <Label Text="Tu ventana diaria al mundo" TextColor="#8A99A8" FontSize="16"/>
                <BoxView HeightRequest="1" BackgroundColor="#1A3A5A" Margin="0,15,0,0" WidthRequest="150" HorizontalOptions="Start"/>
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 25" StrokeThickness="1" Stroke="#1E3A5A"
                    BackgroundColor="#0F253E" Padding="0" HeightRequest="220">
                <Grid>
                    
                    <VerticalStackLayout Spacing="7" Padding="15">
                        <Border Background="#1A3A5A" StrokeShape="RoundRectangle 10" Padding="8,2" HorizontalOptions="Start">
                            <Label Text="● Últimas Noticias" TextColor="#64B5F6" FontSize="11"/>
                        </Border>
                        <Label Text="URGENTE • MUNDO • TECNOLOGÍA • ACTUALIDAD" TextColor="#4FC3F7" FontSize="10" CharacterSpacing="2"/>
                        <Label Text="Lo que está pasando&#10;ahora mismo" FontSize="24" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Información verificada en tiempo real de las fuentes más relevantes nacionales y del mundo." 
                               TextColor="#8A99A8" FontSize="13" LineBreakMode="WordWrap"/>
                        
                        <HorizontalStackLayout Spacing="5" Margin="0,5,0,0">
                            <Label Text="Explora tus noticias de actualidad" TextColor="#4FC3F7" VerticalOptions="Center"/>
                            <Label Text="→" TextColor="#4FC3F7" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Button BackgroundColor="Transparent" Command="{Binding GoToLatestNewsCommand}"/>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                
                <Border Grid.Column="0" StrokeShape="RoundRectangle 25" BackgroundColor="#0F253E" 
                        HeightRequest="180" StrokeThickness="1" Stroke="#1E3A5A">
                    <Grid>
                        
                        <VerticalStackLayout Spacing="7" Padding="15">
                            <Label Text="📂" FontSize="24" Margin="0,5"/>
                            <Label Text="SECCIONES" TextColor="#4FC3F7" FontSize="9" CharacterSpacing="1"/>
                            <Label Text="Categorías" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                            <Label Text="Ver →" TextColor="#4FC3F7" Margin="0,5"/>
                        </VerticalStackLayout>
                        <Button BackgroundColor="Transparent" Command="{Binding GoToCategoryCommand}"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" StrokeShape="RoundRectangle 25" BackgroundColor="#0F253E" 
                        HeightRequest="180" StrokeThickness="1" Stroke="#1E3A5A">
                    <Grid>
                        <VerticalStackLayout Spacing="7" Padding="15">
                            <Label Text="⚙️" FontSize="24" Margin="0,5"/>
                            <Label Text="CONFIGURACIÓN" TextColor="#4FC3F7" FontSize="9" CharacterSpacing="1"/>
                            <Label Text="Opciones" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                            <Label Text="Ajustar →" TextColor="#4FC3F7" Margin="0,5"/>
                        </VerticalStackLayout>
                        <Button BackgroundColor="Transparent" Command="{Binding GoToSettingsCommand}"/>
                    </Grid>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

    <Grid Grid.Row="1" Padding="25,10,25,20" ColumnDefinitions="*, Auto">
        <Label Text="V.1.0 • Build 1" TextColor="Black" FontSize="14" VerticalOptions="Center"/>
    </Grid>
</Grid>
</ContentPage>