<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FeedHub_App.ViewModels"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
    x:DataType="vm:MainViewModel"
    x:Class="FeedHub_App.Views.MainPage">

    <Grid RowDefinitions="*, Auto" Padding="0">
        <Image Source="fondo_de_mundo.png" 
               Aspect="AspectFill"
               Opacity="1" 
               Grid.RowSpan="2"/>
        
        <BoxView Color="Black" Opacity="0" Grid.RowSpan="2"/>

        <ScrollView Grid.Row="0">   
            <VerticalStackLayout Padding="25" Spacing="20">
                
                <VerticalStackLayout Margin="0,40,0,20" Spacing="5">
                    <Label Text="FeedHub" 
                           FontSize="32" 
                           FontAttributes="Bold" 
                           TextColor="#FFC3D4E2" />
                    
                    <Label Text="Your daily window to the world" 
                           FontSize="16" 
                           TextColor="#FFC3D4E2" />
                </VerticalStackLayout>

                <Border StrokeShape="RoundRectangle 15"
                        BackgroundColor="{AppThemeBinding Light=#CCFFFFFF, Dark=#1E293B}"
                        Opacity="0.9"
                        StrokeThickness="1"
                        HeightRequest="120">
                    <Grid>
                        <Grid Padding="20">
                            <Label Text="📰 Latest News" TextColor="{AppThemeBinding Light=#334155, Dark=White}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Text="Check what's happening right now" TextColor="{AppThemeBinding Light=#334155, Dark=White}" FontSize="14" VerticalOptions="End" />
                        </Grid>
                        <Button BackgroundColor="Gray" Opacity="0.15"
                                BorderColor="Cyan" BorderWidth="0.5" 
                                Command="{Binding GoToLatestNewsCommand}" />
                    </Grid>
                </Border>

                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center" Margin="0,10">
                    
                    <Border StrokeShape="RoundRectangle 20" 
                            BackgroundColor="{AppThemeBinding Light=#CCFFFFFF, Dark=#1E293B}"
                            FlexLayout.Basis="48%"
                            HeightRequest="150"
                            StrokeThickness="0"
                            Opacity="0.9">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="{AppThemeBinding Light=0.1, Dark=0.4}" />
                        </Border.Shadow>
                        <Grid>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="10" Padding="15">
                                <Label Text="📂" FontSize="40" HorizontalOptions="Center"/>
                                <Label Text="Explore by categories" FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#333, Dark=White}"
                                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Button BackgroundColor="Transparent" 
                                    Command="{Binding GoToCategoryCommand}" />
                        </Grid>
                    </Border>

                    <Border StrokeShape="RoundRectangle 20" 
                            BackgroundColor="{AppThemeBinding Light=#CCFFFFFF, Dark=#1E293B}"
                            FlexLayout.Basis="48%"
                            HeightRequest="150"
                            StrokeThickness="0"
                            Opacity="0.9">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="{AppThemeBinding Light=0.1, Dark=0.4}" />
                        </Border.Shadow>
                        <Grid>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="10" Padding="15">
                                <Label Text="⚙️" FontSize="40" HorizontalOptions="Center"/>
                                <Label Text="Options" FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#333, Dark=White}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <Button BackgroundColor="Transparent" 
                                    Command="{Binding GoToSettingsCommand}" />
                        </Grid>
                    </Border>
                </FlexLayout>

            </VerticalStackLayout> </ScrollView>

        <Label Grid.Row="1" Text="{Binding AppVersion, StringFormat='Version {0}'}"
               FontSize="14" HorizontalOptions="Center" VerticalOptions="End"
               Margin="0,0,0,20" TextColor="White"/>
               
    </Grid>
</ContentPage>