<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FeedHub_App.ViewModels"
    x:Class="FeedHub_App.Views.MainPage">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="30" Spacing="25">
        <Label Text="Welcome to FeedHub"
               Style="{StaticResource Headline}"
               HorizontalOptions="Center" />

        <Button Text="Latest News"
                Command="{Binding GoToLatestNewsCommand}" 
                WidthRequest="200"
                Margin="0,125,0,0"/>

        <Button Text="Explore by category"
                Command="{Binding GoToExploreCommand}" 
                WidthRequest="200"/>

        <Button Text="Settings"
                Command="{Binding GoToSettingsCommand}" 
                WidthRequest="200"/>

        <Label Text="{Binding AppVersion}"
               FontSize="12"
               HorizontalOptions="Center"
               Margin="0,100,0,0"
               TextColor="Gray" />
    </VerticalStackLayout>
</ContentPage>
