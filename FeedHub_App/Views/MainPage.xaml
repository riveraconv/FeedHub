<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FeedHub_App.ViewModels"
    Shell.NavBarIsVisible="False"
    x:DataType="vm:MainViewModel"
    x:Class="FeedHub_App.Views.MainPage"
    BackgroundColor="#0F172A"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

        <ContentPage.Behaviors>
                <toolkit:StatusBarBehavior StatusBarColor="Transparent" StatusBarStyle="LightContent" />
        </ContentPage.Behaviors>

    <Grid IgnoreSafeArea="True">
             <BoxView IsEnabled="False" 
                 InputTransparent="True"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill">
            <BoxView.Background>
                <RadialGradientBrush Center="0.8, 0.2" Radius="0.7">
                    
                    <GradientStop Color="#2638BDF8" Offset="0.1" />
                    
                    <GradientStop Color="#000F172A" Offset="0.8" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

    <Grid RowDefinitions="*, Auto">


    <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="25,45,25,25" Spacing="16">
            
            <VerticalStackLayout Spacing="4">
                <Label Text="FeedHub" FontSize="44" FontAttributes="Bold" TextColor="#F8FAFC"/>
                <Label Text="Tu ventana diaria al mundo" TextColor="#94A3B8" FontSize="16"/>
                <BoxView HeightRequest="1" BackgroundColor="#38BDF8"  WidthRequest="40" HorizontalOptions="Start" Margin="0,10,0,0"/>
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 24" StrokeThickness="1" Stroke="#1E3A5A"
                    BackgroundColor="#1E293B" Padding="0" HeightRequest="230">
                <Grid>
                    
                    <VerticalStackLayout Spacing="8" Padding="20">
                        <Border Background="#334155" StrokeShape="RoundRectangle 8" Padding="10,4" HorizontalOptions="Start" >
                            <Label Text="● Últimas Noticias" TextColor="#38BDF8" FontSize="11" FontAttributes="Bold"/>
                        </Border>
                        <Label Text="GLOBAL • MUNDO • TECNOLOGÍA • ACTUALIDAD" TextColor="#7DD3FC" FontSize="10" CharacterSpacing="1.5"/>
                        <Label Text="Lo que está pasando&#10;ahora mismo" FontSize="24" FontAttributes="Bold" TextColor="#F8FAFC" LineBreakMode="WordWrap"/>
                        <Label Text="Información verificada en tiempo real de las fuentes más relevantes nacionales y del mundo." 
                               TextColor="#94A3B8" FontSize="12" LineBreakMode="WordWrap"/>
                        
                        <HorizontalStackLayout Spacing="8" Margin="0,3,0,0">
                            <Label Text="Explorar ahora" TextColor="#38BDF8" VerticalOptions="Center"/>
                            <Label Text="→" TextColor="#4FC3F7" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Button BackgroundColor="Transparent" Command="{Binding GoToLatestNewsCommand}"/>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="15" RowSpacing="15">
                
                <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 24" BackgroundColor="#1E293B" 
                        HeightRequest="170" StrokeThickness="1" Stroke="#1E3A5A">
                    <Grid>
                        <VerticalStackLayout Spacing="8" Padding="20" VerticalOptions="Center">
                            <Label Text="📂" FontSize="32" Margin="0,0,0,5"/>
                            <Label Text="SECCIONES" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                            <Label Text="Categorías" TextColor="#F8FAFC" FontSize="18" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <Button BackgroundColor="Transparent" Command="{Binding GoToCategoryCommand}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 24" BackgroundColor="#1E293B" 
                        HeightRequest="170" StrokeThickness="1" Stroke="#1E3A5A">
                    <Grid>
                            <VerticalStackLayout Spacing="8" Padding="20" VerticalOptions="Center">
                                <Label Text="⚙️" FontSize="32" Margin="0,0,0,5"/>
                                <Label Text="AJUSTES" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                <Label Text="Opciones" TextColor="#F8FAFC" FontSize="18" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <Button BackgroundColor="Transparent" Command="{Binding GoToSettingsCommand}"/>
                        </Grid>
                    </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="2" StrokeShape="RoundRectangle 24" StrokeThickness="1"
                            BackgroundColor="#1E293B" HeightRequest="130" Stroke="#1E3A5A">
                        <Grid ColumnDefinitions="80, *">
                            <Label Grid.Column="0" Text="📰" FontSize="44" VerticalOptions="Center" HorizontalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="FUENTES" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                <Label Text="Noticias por Periódico" TextColor="#F8FAFC" FontSize="18" FontAttributes="Bold"/>
                                <Label Text="El País, El Mundo, ABC y más" TextColor="#94A3B8" FontSize="13"/>
                            </VerticalStackLayout>
                            <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" Command="{Binding GoToCategoriesBySourceCommand}"/>
                        </Grid>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" Padding="25,10,25,50">
            <Label Text="{Binding AppVersion}" TextColor="#475569" FontSize="12" HorizontalOptions="Start"/>
        </Grid>
    </Grid>
    </Grid>
</ContentPage>