<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FeedHub_App.ViewModels.News"
             xmlns:models="clr-namespace:FeedHub_Core.Models;assembly=FeedHub_Core"
             x:DataType="viewmodels:LatestNewsViewModel"
             x:Class="FeedHub_App.Views.News.LatestNewsPage"
             x:Name="Page"
             Shell.NavBarIsVisible="False"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">


    <Grid IgnoreSafeArea="True">
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0"
                        EndPoint="1,1">
                    <GradientStop Color="#0D253F"
                            Offset="0.1"/>
                    <GradientStop Color="#813B83F6"
                            Offset="1.0"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto,*"
                Padding="20,20,20,0">

            <VerticalStackLayout Grid.Row="0"
                    Spacing="5"
                    Margin="0,10,0,20">
                <Label Text="ÚLTIMAS NOTICIAS"
                       TextColor="#4FC3F7"
                       FontSize="12"
                       FontAttributes="Bold"
                       CharacterSpacing="2"/>
                <Label Text="FeedHub"
                       TextColor="White"
                       FontSize="32"
                       FontAttributes="Bold"/>
                <BoxView HeightRequest="1"
                         BackgroundColor="#1A3A5A"
                         WidthRequest="100"
                         HorizontalOptions="Start"/>
            </VerticalStackLayout>

            <RefreshView Grid.Row="1"
                         x:DataType="viewmodels:LatestNewsViewModel"
                         Command="{Binding LoadNewsCommand}"
                         IsRefreshing="{Binding IsRefreshing}"
                         RefreshColor="#4FC3F7">

                <CollectionView ItemsSource="{Binding News}"
                                SelectionMode="Single"
                                x:Name="NewsCollection"
                                SelectionChanged="OnSelectionChanged">           

                    <CollectionView.EmptyView>
                        <VerticalStackLayout x:DataType="viewmodels:LatestNewsViewModel"
                                            Padding="30"
                                            Spacing="20"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                            <ActivityIndicator IsRunning="{Binding IsLoading}"
                                               Color="#4FC3F7"
                                               HeightRequest="50"
                                               WidthRequest="50"/>
                            <Label Text="Preparando noticias..."
                                   HorizontalTextAlignment="Center"
                                   TextColor="#8A99A8"
                                   FontSize="16"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:NewsItem">
                            <Border Stroke="#1E3A5A"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 20"
                                    Margin="0,10,0,10"
                                    BackgroundColor="#0F253E"
                                    Padding="0"
                                    MaximumWidthRequest="800">


                                <Grid RowDefinitions="Auto, Auto">

                                    <Grid Grid.Row="0"
                                            IsVisible="{Binding ImageUrl, Converter={StaticResource NullToBoolConverter}}">
                                        <Image Source="{Binding ImageUrl}"
                                               HeightRequest="200"
                                               Aspect="AspectFill"
                                               HorizontalOptions="Fill"
                                               MaximumHeightRequest="200"/>

                                        <BoxView VerticalOptions="End"
                                                HeightRequest="60">
                                            <BoxView.Background>
                                                <LinearGradientBrush StartPoint="0,0"
                                                        EndPoint="0,1">
                                                    <GradientStop Color="Transparent"
                                                            Offset="0.8"/>
                                                    <GradientStop Color="#0F253E"
                                                            Offset="1"/>
                                                </LinearGradientBrush>
                                            </BoxView.Background>
                                        </BoxView>
                                    </Grid>

                                    <Grid Grid.Row="1"
                                            Padding="15"
                                            RowSpacing="10"
                                            RowDefinitions="Auto, Auto, Auto, Auto">

                                        <Label Grid.Row="0"
                                               Text="{Binding Title}"
                                               FontAttributes="Bold"
                                               FontSize="18"
                                               TextColor="White"
                                               LineBreakMode="WordWrap"/>

                                        <Grid Grid.Row="1"
                                                ColumnDefinitions="Auto,Auto,*"
                                                ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Source}"
                                                   FontSize="12"
                                                   TextColor="#4FC3F7"
                                                   FontAttributes="Bold"/>
                                            <Label Grid.Column="1"
                                                   Text="•"
                                                   TextColor="#8A99A8"/>
                                            <Label Grid.Column="2"
                                                   Text="{Binding PublishDate, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                                   FontSize="12"
                                                   TextColor="#8A99A8"/>
                                        </Grid>

                                        <Label Grid.Row="2"
                                               Text="{Binding Description}"
                                               FontSize="14"
                                               TextColor="#CBD5E1"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="3"
                                               IsVisible="{Binding Description, Converter={StaticResource NullToBoolConverter}}"/>

                                        <Label Grid.Row="3"
                                               Text="Leer más →"
                                               TextColor="#4FC3F7"
                                               FontSize="12"
                                               HorizontalOptions="End"
                                               Margin="0,5,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>
        </Grid>
        <BoxView VerticalOptions="Start"
                 HeightRequest="20"
                 InputTransparent="True"
                 Margin="0,120,0,0">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0"
                        EndPoint="0,1">
                    <GradientStop Color="#12304D"
                            Offset="0"/>
                    <GradientStop Color="Transparent"
                            Offset="1.0"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <BoxView VerticalOptions="End"
                 HeightRequest="20"
                 InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0"
                        EndPoint="0,1">
                    <GradientStop Color="Transparent"
                            Offset="0"/>
                    <GradientStop Color="#12304D"
                            Offset="1.0"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
    </Grid>
</ContentPage>