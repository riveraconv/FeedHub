<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FeedHub_App.ViewModels.News"
             xmlns:models="clr-namespace:FeedHub_Core.Models;assembly=FeedHub_Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:utils="clr-namespace:FeedHub_App.Utilities"
             xmlns:controls="clr-namespace:FeedHub_App.Controls"
             x:Class="FeedHub_App.Views.News.LatestNewsPage"
             x:Name="Page"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightBackground}, Dark={StaticResource FeedHubDarkBackground}}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="Transparent" 
                                   StatusBarStyle="{AppThemeBinding Light=DarkContent,Dark=LightContent}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- TEMPLATE NOTICIA -->
            <DataTemplate x:Key="NewsTemplate">
                <Border StrokeThickness="2" 
                        Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder}, Dark={StaticResource FeedHubDarkCardBorder}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2}, Dark={StaticResource FeedHubDarkCard}}"
                        StrokeShape="RoundRectangle 24"
                        Margin="10,10,10,10">
                        
                    <Grid RowDefinitions="200, Auto">
                        <Grid Grid.Row="0">
                            <BoxView HorizontalOptions="Fill" VerticalOptions="Fill">
                                <BoxView.Background>
                                    <RadialGradientBrush Center="0.8,0.15"
                                                        Radius="0.9">
                                        <GradientStop
                                            Color="{AppThemeBinding Light=#BFDFFF, Dark=#2638BDF8}"
                                            Offset="0.0"/>
                                        <GradientStop
                                            Color="{AppThemeBinding Light=#EAF3FB, Dark =#0D253F}"
                                            Offset="0.75"/>
                                    </RadialGradientBrush>
                                </BoxView.Background>
                            </BoxView>
                            <Label Text="FeedHub"
                                   TextColor="{AppThemeBinding Light={StaticResource FeedHubLightMainBlue}, Dark={StaticResource FeedHubDarkAccent}}"
                                   FontSize="38"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Opacity="0.3"/>
                            <Image Source="{Binding ImageUrl}"
                                   HeightRequest="200"
                                   Aspect="AspectFill"
                                   IsVisible="{Binding ImageUrl, Converter={StaticResource NullToBoolConverter}}"/>
                            <BoxView VerticalOptions="End" HeightRequest="10" InputTransparent="True">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="{AppThemeBinding Light=#ECF2FA, Dark=#1E293B}"
                                                      Offset="1"/>
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>
                        </Grid>
                        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="10">
                            <Label  Text="{Binding Title}" FontAttributes="Bold" FontSize="19" 
                                    TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary},
                                                Dark={StaticResource FeedHubDarkTextPrimary}}" 
                                    LineBreakMode="WordWrap"/>
                            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *" ColumnSpacing="6">
                                <Label  Grid.Column="0" Text="{Binding Source}" FontSize="12" 
                                        TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent},
                                                    Dark={StaticResource FeedHubDarkAccent}}" 
                                        FontAttributes="Bold"/>
                                <Label  Grid.Column="1" Text="•" 
                                        TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary},
                                                                            Dark={StaticResource FeedHubDarkTextSecondary}}"/>
                                <Label  Grid.Column="2" Text="{Binding PublishDate, StringFormat='{0:dd MMM, HH:mm}'}" FontSize="12" 
                                                        TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary},
                                                        Dark={StaticResource FeedHubDarkTextSecondary}}"/>
                                <Label  Grid.Column="3" Text="•" TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary},
                                                                            Dark={StaticResource FeedHubDarkTextSecondary}}"/>
                                <Label  Grid.Column="4" Text="{Binding Category}" FontSize="12" 
                                        TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary},
                                                Dark={StaticResource FeedHubDarkTextSecondary}}" 
                                        FontAttributes="Bold"/>
                            </Grid>
                            <Label  Text="{Binding Description}" FontSize="14"
                                    TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary},
                                                Dark={StaticResource FeedHubDarkTextSecondary}}"
                                LineBreakMode="TailTruncation" MaxLines="3"
                                   IsVisible="{Binding Description, Converter={StaticResource NullToBoolConverter}}"/>
                            <Label Text="Leer noticia completa →" 
                                TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent},
                                            Dark={StaticResource FeedHubDarkAccent}}"
                                FontSize="13" FontAttributes="Bold" HorizontalOptions="End" Margin="0,5,0,0"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- TEMPLATE ANUNCIO -->
            <DataTemplate x:Key="AdTemplate">
                <Border StrokeThickness="2" 
                        Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder}, Dark={StaticResource FeedHubDarkCardBorder}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2}, Dark={StaticResource FeedHubDarkCard}}"
                        StrokeShape="RoundRectangle 24"
                        Margin="10,10,10,10">
                    <Grid RowDefinitions="200, Auto">

                        <!-- ZONA IMAGEN — mismo tamaño que las noticias -->
                        <Grid Grid.Row="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2}, Dark={StaticResource FeedHubDarkSurfaceSecondary}}">
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                                <Label Text="📢"
                                       FontSize="48"
                                       HorizontalOptions="Center"/>
                                <Label Text="ESPACIO PUBLICITARIO"
                                       TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent}, Dark={StaticResource FeedHubDarkAccent}}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="2"
                                       HorizontalOptions="Center"/>
                                <Label Text="Aquí aparecerá tu anuncio"
                                       TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary}, Dark={StaticResource FeedHubDarkTextSecondary}}"
                                       FontSize="12"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- ZONA CONTENIDO — mismo padding que las noticias -->
                        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="10">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border Grid.Column="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightAccentSoft}, Dark={StaticResource FeedHubDarkAccentSoft}}"
                                        StrokeShape="RoundRectangle 4"
                                        Padding="6,2"
                                        StrokeThickness="0">
                                    <Label Text="Anuncio"
                                           TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent}, Dark={StaticResource FeedHubDarkAccent}}"
                                           FontSize="10"
                                           FontAttributes="Bold"/>
                                </Border>
                                <Label Grid.Column="1"
                                       Text="Contenido patrocinado"
                                       TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary}, Dark={StaticResource FeedHubDarkTextSecondary}}"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       Margin="8,0,0,0"/>
                            </Grid>
                            <Label Text="Tu anuncio aparecerá aquí"
                                   FontAttributes="Bold"
                                   FontSize="19"
                                   TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary}, Dark={StaticResource FeedHubDarkTextPrimary}}"
                                   LineBreakMode="WordWrap"
                                   Opacity="0.3"/>
                            <Label Text="Descripción del anuncio..."
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary}, Dark={StaticResource FeedHubDarkTextSecondary}}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="3"
                                   Opacity="0.3"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- SELECTOR -->
            <utils:NewsTemplateSelector x:Key="NewsTemplateSelector"
                                        NewsTemplate="{StaticResource NewsTemplate}"
                                        AdTemplate="{StaticResource AdTemplate}"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid IgnoreSafeArea="True">
        <BoxView IsEnabled="False"
         InputTransparent="True"
         HorizontalOptions="Fill"
         VerticalOptions="Fill">

    <BoxView.Background>
        <RadialGradientBrush Center="0.8,0.2"
                             Radius="0.7">

            <GradientStop
                Color="{AppThemeBinding
                    Light=#B8DFFF,
                    Dark=#2638BDF8}"
                Offset="0.1" />

            <GradientStop
                Color="{AppThemeBinding
                    Light=#00F4F8FC,
                    Dark=#000F172A}"
                Offset="0.8" />

        </RadialGradientBrush>
    </BoxView.Background>

</BoxView>

        <Grid RowDefinitions="Auto, *" Padding="0,45,0,0">
            
            <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="25,10,25,20">
                <Label  Text="FEEDHUB"
                        TextColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent}, Dark={StaticResource FeedHubDarkAccent}}" 
                        FontSize="12" FontAttributes="Bold" CharacterSpacing="2"/>
                <Label  Text="Ponte al día"
                        TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary}, Dark={StaticResource FeedHubDarkTextPrimary}}"
                        FontSize="32" FontAttributes="Bold"/>
                <BoxView HeightRequest="3"
                         BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightAccent}, Dark={StaticResource FeedHubDarkAccent}}" 
                         WidthRequest="40" 
                         HorizontalOptions="Start" 
                         Margin="0,8,0,0"/>
            </VerticalStackLayout>

            <!-- TRANSICIÓN DEL HEADER AL FEED -->
            <Grid Grid.Row="0"
                  VerticalOptions="End"
                  HeightRequest="5"
                  InputTransparent="True"
                  ZIndex="10">

                <BoxView>
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1">

                            <GradientStop
                                Color="{AppThemeBinding
                        Light=#FFF4F8FC,
                        Dark=#FF0F172A}"
                                Offset="0.0"/>

                            <GradientStop
                                Color="{AppThemeBinding
                        Light=#00F4F8FC,
                        Dark=#000F172A}"
                                Offset="1.0"/>

                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                </Grid>
                <Grid Grid.Row="1">

                <CollectionView ItemsSource="{Binding News}"
                                IsVisible="{Binding HasContent}"
                                SelectionMode="Single"
                                x:Name="NewsCollection"
                                SelectionChanged="OnSelectionChanged"
                                ItemTemplate="{StaticResource NewsTemplateSelector}">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>


                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="35,10,35,50" Spacing="0">
                            <Grid HeightRequest="50">
                                <Border IsVisible="{Binding CanLoadMore}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightAccentSoft},
                                                        Dark={StaticResource FeedHubDarkAccentSoft}}" 
                                        Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                                Dark={StaticResource FeedHubDarkCardBorder}}"
                                        StrokeShape="RoundRectangle 25" 
                                        StrokeThickness="1"  
                                        HorizontalOptions="Fill" WidthRequest="200" HeightRequest="40">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsLoadingMore}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LoadMoreCommand}"/>
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                        <Image Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf103;', Color=#38BDF8,
                                             Size=16}" VerticalOptions="Center"/>
                                        <Label Text="Cargar más noticias" 
                                               TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextAccent},
                                                          Dark={StaticResource FeedHubDarkTextAccent}}"
                                                FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Image Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf103;', Color=#38BDF8, Size=16}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                                <ActivityIndicator IsRunning="{Binding IsLoadingMore}" IsVisible="{Binding IsLoadingMore}"
                                    Color="{AppThemeBinding Light={StaticResource FeedHubLightAccent},
                                            Dark={StaticResource FeedHubDarkAccent}}"
                                    VerticalOptions="Center" HorizontalOptions="Center" HeightRequest="30" WidthRequest="30"/>
                            </Grid>
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>

                    <!-- FADE SUPERIOR DEL FEED -->
                    <Grid HeightRequest="20"
                          VerticalOptions="Start"
                          HorizontalOptions="Fill"
                          InputTransparent="True"
                          ZIndex="10">

                        <BoxView>
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="0,1">

                                    <GradientStop
                                        Color="{AppThemeBinding
                                                    Light={StaticResource FeedHubLightBackground},
                                                    Dark={StaticResource FeedHubDarkBackground}}"
                                        Offset="0.0"/>

                                    <GradientStop
                                        Color="{AppThemeBinding
                                                    Light=#00F4F8FC,
                                                    Dark=#000F172A}"
                                        Offset="1.0"/>

                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                    </Grid>
                    <!-- Error de conexión -->
                <Grid IsVisible="{Binding HasError}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    TranslationY="-80">

                    
                    <VerticalStackLayout
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Spacing="15"
                        Padding="40">

                        <controls:StatusMessageView
                            Icon="📡"
                            Title="Sin conexión"
                            Message="No se ha podido establecer la conexión con Internet."
                            ButtonText="Reintentar"
                            Command="{Binding LoadNewsCommand}"/>

                    </VerticalStackLayout>

                </Grid>

                <Grid IsVisible="{Binding IsLoading}"
                      VerticalOptions="Center"
                      HorizontalOptions="Center"
                      TranslationY ="-40">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                        <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                           Color="{AppThemeBinding Light={StaticResource FeedHubLightAccent}, Dark={StaticResource FeedHubDarkAccent}}" 
                                           HorizontalOptions="Center" HeightRequest="50" WidthRequest="50"/>
                        <Label  Text="Preparando noticias..." HorizontalTextAlignment="Center" 
                                TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary}, Dark={StaticResource FeedHubDarkTextSecondary}}" 
                                FontSize="16"/>
                    </VerticalStackLayout>
                </Grid>

               <!-- Sin contenido por filtros -->

                <Grid IsVisible="{Binding IsContentEmpty}"
                      VerticalOptions="Center"
                      HorizontalOptions="Center"
                      TranslationY="-80">
                
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15" Padding="40">
                        <controls:StatusMessageView
                            Icon="⚙️"
                            Title="No hay contenido"
                            Message="Has filtrado todo el contenido. Ve a Ajustes para activar alguna categoría o fuente de noticias."
                            ButtonText="Ir a Ajustes"
                            Command="{Binding GoToSettingsCommand}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Sin contenido disponible -->

                <Grid IsVisible="{Binding IsLatestEmpty}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    TranslationY="-80">

                    <VerticalStackLayout
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Spacing="15"
                        Padding="40">

                        <controls:StatusMessageView
                            Icon="📰"
                            Title="No hay contenido disponible"
                            Message="No hay noticias disponibles para esta categoría con las fuentes que tienes activadas."
                            ButtonText="Ir a Ajustes"
                            Command="{Binding GoToSettingsCommand}" />

                    </VerticalStackLayout>

                </Grid>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>