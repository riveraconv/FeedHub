<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeedHub_App.Views.News.QuickViewPage"
             Title=""
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">


    <Grid RowDefinitions="Auto, *">

        <!-- Info banner (siempre arriba) -->
        <Label x:Name="InfoBanner"
               Grid.Row="0"
               Text=""
               BackgroundColor="#334155"
               TextColor="White"
               FontSize="14"
               Padding="10"
               IsVisible="False"
               HorizontalOptions="Fill"/>
        <!-- Contenedor principal -->
        <Grid Grid.Row="1">

            <!-- QuickView Container -->
            <Grid x:Name="QuickViewContainer" IsVisible="False" RowDefinitions="Auto, *, Auto">

                <!-- Scrollable content -->
                <ScrollView Grid.Row="1">
                    <StackLayout>
                        <!-- Imagen principal -->
                        <Image x:Name="ArticleImage"
                               Aspect="AspectFill"
                               HeightRequest="200"
                               Margin="10"/>

                        <!-- Contenido HTML -->
                        <WebView x:Name="ArticleWebView"
                                 VerticalOptions="Fill"/>
                    </StackLayout>
                </ScrollView>

                <!-- Título flotante -->
                <Label x:Name="TitleLabel"
                       Text="Cargando..."
                       FontSize="20"
                       TextColor="White"
                       FontAttributes="Bold"
                       BackgroundColor="#1e2430"
                       Padding="10"
                       VerticalOptions="Start"
                       HorizontalOptions="Fill"
                       LineBreakMode="WordWrap"/>

                
            </Grid>

            <!-- Full Web fallback -->
            <WebView x:Name="FullWebView"
                     IsVisible="False"
                     VerticalOptions="Fill"
                     HorizontalOptions="Fill"/>
        </Grid>

        <!-- Botón cerrar -->
        <Button Text="✕"
                Clicked="OnCloseClicked"
                BackgroundColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                WidthRequest="44"
                HeightRequest="44"
                Opacity="0.8"
                Grid.Row="1"/>

        <Button x:Name="SourceButton"
                Text="🌐"
                Clicked="OnSourceClicked"
                BackgroundColor="White"
                VerticalOptions="End"
                HorizontalOptions="Start"
                Margin="70,20,20,20"
                WidthRequest="44"
                HeightRequest="44"
                Opacity="0.8"
                Grid.Row="1"/>
        
        <Button x:Name="ShareButton"
                Text="🔗"
                Clicked="OnShareClicked"
                BackgroundColor="White"
                VerticalOptions="End"
                HorizontalOptions="Start"
                Margin="20,20,20,20"
                WidthRequest="44"
                HeightRequest="44"
                Opacity="0.8"
                Grid.Row="1"/>
        
        <Button x:Name="SpeakButton"
                Text="{Binding SpeakIcon}"
                Command="{Binding SpeakNewsCommand}"
                BackgroundColor="White"
                VerticalOptions="End"
                HorizontalOptions="Start"
                Margin="120,20,20,20" 
                WidthRequest="44"
                HeightRequest="44"
                Opacity="0.8"
                Grid.Row="1">
            
            <Button.Triggers>
                <DataTrigger TargetType="Button" 
                             Binding="{Binding Source={x:Reference QuickViewContainer}, Path=IsVisible}" 
                             Value="False">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
        
    </Grid>
    
</ContentPage>





