<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeedHub_App.Views.News.QuickViewPage"
             Title=""
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Shell.PresentationMode="ModalAnimated">

<ContentPage.Resources>
    <Style x:Key="ActionBtnStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="WidthRequest" Value="50"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal" />
                    
                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.85" />
                            <Setter Property="BackgroundColor" Value="#15000000" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
</ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <Label x:Name="InfoBanner"
               Grid.Row="0"
               BackgroundColor="#1E293B"
               TextColor="White"
               FontSize="12"
               Padding="8"
               HorizontalTextAlignment="Center"
               IsVisible="False"/>

        <Grid Grid.Row="1">
            <Grid x:Name="QuickViewContainer" 
                  IsVisible="False" 
                  BackgroundColor="Transparent"
                  Margin="5,0,5,0">
                
                <ScrollView >
                    <VerticalStackLayout Spacing="0">
                        
                        <Image x:Name="ArticleImage"
                               Aspect="AspectFit"
                               HeightRequest="280"
                               HorizontalOptions="Fill"/>

                        <VerticalStackLayout Padding="24,24,24,100" Spacing="16">
                            
                            <Label Text="FEEDHUB // QUICK VIEW"
                                   FontSize="11" 
                                   CharacterSpacing="1.5"
                                   TextColor="#3B82F6" 
                                   FontAttributes="Bold" />

                            <Label x:Name="TitleLabel"
                                   Text="Cargando título..."
                                   FontSize="20"
                                   LineHeight="1.2"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                            <BoxView HeightRequest="1.5" 
                                     Color="#3B82F6" 
                                     Margin="0,8,0,-10" 
                                     HorizontalOptions="Fill" 
                                     Opacity="0.8"/>

                            <WebView x:Name="ArticleWebView"
                                     VerticalOptions="Fill"
                                     HorizontalOptions="Fill"
                                     BackgroundColor="Transparent">
                            <WebView.Source>
                                    <HtmlWebViewSource Html="{Binding ArticleContent}" />
                            </WebView.Source>
                                     </WebView>
                                     <BoxView HeightRequest="1.5" 
                                     Color="#3B82F6"  
                                     HorizontalOptions="Fill"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
                </Grid>

                <WebView x:Name="FullWebView"
                     IsVisible="False"
                     BackgroundColor="Transparent"
                     VerticalOptions="Fill"
                     HorizontalOptions="Fill"/>
                <Border VerticalOptions="End" 
                        HorizontalOptions="Center" 
                        Margin="0,0,0,30" 
                        Padding="10,2"
                        StrokeShape="RoundRectangle 30" 
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                        Stroke="#E2E8F0" 
                        StrokeThickness="1"> 
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.15"/>
                    </Border.Shadow>
                    <HorizontalStackLayout Spacing="5">
                        <Button x:Name = "ShareButton" Text="🔗" Clicked="OnShareClicked" Style="{StaticResource ActionBtnStyle}"/>
                        <Button x:Name = "SourceButton" Text="🌐" Clicked="OnSourceClicked" Style="{StaticResource ActionBtnStyle}"/>
                        <Button x:Name = "SpeakButton" Text="{Binding SpeakIcon}" Command="{Binding SpeakNewsCommand}" Style="{StaticResource ActionBtnStyle}"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>
</ContentPage>