<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeedHub_App.Views.News.QuickViewPage"
             Title=""
             Shell.NavBarIsVisible="False"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

<ContentPage.Behaviors>
    <toolkit:StatusBarBehavior StatusBarColor="Transparent" StatusBarStyle="DarkContent"/>
</ContentPage.Behaviors>

<ContentPage.Resources>
    <Style x:Key="ActionBtnStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="WidthRequest" Value="50"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal" />
                    
                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.85" />
                            <Setter Property="BackgroundColor" Value="#15000000" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
</ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" IgnoreSafeArea="True">

        <Label x:Name="InfoBanner"
               Grid.Row="0"
               BackgroundColor="Transparent"
               TextColor="White"
               FontSize="18"
               Padding="18"
               HorizontalTextAlignment="Center"
               IsVisible="False"
               Margin="0,15,0,0"/>

        <Grid Grid.Row="1">
            <Grid x:Name="QuickViewContainer" 
                  IsVisible="False" 
                  BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                  Margin="0,0,0,0">
                
                <ScrollView BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}" Padding="0,45,0,100">
                    <VerticalStackLayout Spacing="0">
                        
                        <Image x:Name="ArticleImage"
                               Aspect="AspectFill"
                               HeightRequest="280"
                               MaximumHeightRequest="220"
                               HorizontalOptions="Fill"/>

                        <VerticalStackLayout Padding="24,24,24,24" Spacing="16">
                            
                            <Label Text="FEEDHUB // VISTA RÁPIDA"
                                   FontSize="11" 
                                   CharacterSpacing="1.5"
                                   TextColor="#3B82F6" 
                                   FontAttributes="Bold"
                                   Margin="5,0,0,0" />

                            <Label x:Name="TitleLabel"
                                   Text="Cargando título..."
                                   FontSize="20"
                                   LineHeight="1.2"
                                   TextType="Text"
                                   HorizontalTextAlignment="Justify"
                                   Margin="5,0,5,0"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                            <BoxView HeightRequest="1.5" 
                                     Color="#3B82F6" 
                                     Margin="0,8,0,-10" 
                                     HorizontalOptions="Fill" 
                                     Opacity="0.8"/>

                            <WebView x:Name="ArticleWebView"
                                     VerticalOptions="Fill"
                                     HorizontalOptions="Fill"
                                     BackgroundColor="Transparent"/>

                                     <BoxView HeightRequest="1.5" 
                                     Color="#3B82F6"  
                                     HorizontalOptions="Fill"
                                     Margin="0,0,0,20"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
                </Grid>

                <Grid x:Name="NoConnectionPanel"
                    IsVisible="False"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    TranslationY="-80">

                    <VerticalStackLayout
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Spacing="15"
                        Padding="40">

                        <Label Text="📡"
                            FontSize="50"
                            HorizontalTextAlignment="Center"/>

                        <Label Text="Sin conexión"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"/>

                        <Label Text="No hay conexión a Internet. Comprueba tu conexión e inténtalo de nuevo."
                            TextColor="#94A3B8"
                            FontSize="14"
                            HorizontalTextAlignment="Center"/>

                        <Button Text="Reintentar"
                                Clicked="OnRetryClicked"
                                BackgroundColor="#1E3A5A"
                                TextColor="#38BDF8"
                                CornerRadius="20"
                                Margin="0,10,0,0"/>

                    </VerticalStackLayout>
                </Grid>

                <WebView x:Name="FullWebView"
                     IsVisible="False"
                     VerticalOptions="Fill"
                     HorizontalOptions="Fill"
                     Margin="0,30,0,110"
                     BackgroundColor="White"/>

            <Border VerticalOptions="End"
                    HorizontalOptions="Fill"
                    Margin="20,0,20,50"
                    Padding="15,0,5,0"
                    StrokeShape="RoundRectangle 30"
                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                    Stroke="#3B82F6"
                    StrokeThickness="1"
                    MaximumWidthRequest="400">
                <Border.Shadow>
                    <Shadow Brush="Black"
                            Offset="0,10"
                            Radius="20"
                            Opacity="0.15"/>
                </Border.Shadow>

                <Grid ColumnDefinitions="*, 180"
                        HeightRequest="60">

                    <!-- SECCIÓN IZQUIERDA: Textos en vertical -->
                    <VerticalStackLayout Grid.Column="0"
                            VerticalOptions="Center"
                            Spacing="0">
                        <Label Text="FUENTE ORIGINAL"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                               FontSize="9"
                               HorizontalOptions="Center"
                               CharacterSpacing="1"
                               FontAttributes="Bold"
                               Margin="0,0,0,2"/>

                        <Label x:Name="SourceLabel"
                               Text="Cargando..."
                               TextColor="#3B82F6"
                               FontSize="13"
                               HorizontalOptions="Center"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation"
                               VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSourceClicked"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>

                    <!-- SECCIÓN DERECHA: Anclada y estática -->
                    <!-- Usamos un Grid con 4 columnas fijas para que los botones no se desplacen entre sí -->
                    <Grid Grid.Column="1"
                            ColumnDefinitions="Auto, 50, 50, 50"
                            VerticalOptions="Center">

                        <!-- Separador vertical: Posición fija -->
                        <BoxView Grid.Column="0"
                                WidthRequest="1"
                                HeightRequest="40"
                                Color="#3B82F6"
                                Opacity="0.8"
                                Margin="0,0,5,0"/>

                        <Button Grid.Column="1"
                                x:Name="ToggleViewButton"
                                Text="🌐"
                                IsVisible="True"
                                Clicked="OnToggleViewClicked"
                                Style="{StaticResource ActionBtnStyle}"/>

                        <Button Grid.Column="2"
                                x:Name="ShareButton"
                                Text="🔗"
                                Clicked="OnShareClicked"
                                Style="{StaticResource ActionBtnStyle}"/>

                        <!-- Cuando este botón desaparece, su columna (la 3) queda vacía pero mantiene el ancho -->
                        <Button Grid.Column="3"
                                x:Name="SpeakButton"
                                Text="{Binding SpeakIcon}"
                                Command="{Binding SpeakNewsCommand}"
                                Style="{StaticResource ActionBtnStyle}"/>
                    </Grid>
                    </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>