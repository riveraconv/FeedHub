<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FeedHub_App.ViewModels.News"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FeedHub_App.Views.News.CategoriesNewsBySourcePage"
             x:DataType="viewmodels:CategoriesBySourceViewModel"
             x:Name="PageRoot"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0F172A">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="Transparent" StatusBarStyle="LightContent"/>
    </ContentPage.Behaviors>

    <Grid IgnoreSafeArea="True">
        <BoxView InputTransparent="True">
            <BoxView.Background>
                <RadialGradientBrush Center="0.8,0.2" Radius="0.7">
                    <GradientStop Color="#2638BDF8" Offset="0.1"/>
                    <GradientStop Color="#000F172A" Offset="0.8"/>
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto,*" Padding="0,45,0,0">

            <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="25,10,25,5">
                <Label Text="FEEDHUB" TextColor="#38BDF8" FontSize="12" FontAttributes="Bold" CharacterSpacing="2"/>
                <Label Text="Noticias por fuente" TextColor="#F8FAFC" FontSize="32" FontAttributes="Bold"/>
                <BoxView HeightRequest="3" WidthRequest="40" BackgroundColor="#38BDF8" Margin="0,8,0,0" HorizontalOptions="Start"/>
            </VerticalStackLayout>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding GroupedSources}"
                            IsGrouped="True"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="viewmodels:SourceGroup">
                        <Label Text="{Binding CategoryTitle}"
                               TextColor="#38BDF8"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="2"
                               Margin="25,20,0,5"
                               Opacity="0.8"/>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:NewsSource">
                        <Grid Padding="20,5">

                            <Border StrokeShape="RoundRectangle 24"
                                    BackgroundColor="#10FFFFFF"
                                    Stroke="#2638BDF8"
                                    StrokeThickness="2">
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="15,12">
                                    <Border Grid.Column="0"
                                            WidthRequest="42" HeightRequest="42"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="#1E293B"
                                            StrokeThickness="0">
                                        <Image Source="{Binding Domain, StringFormat='https://www.google.com/s2/favicons?domain={0}&amp;sz=64'}"
                                               WidthRequest="26" HeightRequest="26"
                                               Aspect="AspectFit"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="1" Margin="15,0,0,0" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#F8FAFC"/>
                                        <Label Text="{Binding Description}" FontSize="11" TextColor="#94A3B8" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="→" FontSize="22" TextColor="#38BDF8" VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <Button BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    CornerRadius="24"
                                    Clicked="OnSourceClicked"/>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <BoxView HeightRequest="50" Color="#0F172A"/>
                </CollectionView.Footer>

            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>