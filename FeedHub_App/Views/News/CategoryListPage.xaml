<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FeedHub_App.ViewModels.News"
             x:Class="FeedHub_App.Views.News.CategoryListPage"
             x:DataType="viewmodels:CategoryListViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0F172A"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

        <ContentPage.Behaviors>
            <toolkit:StatusBarBehavior StatusBarColor="Transparent" 
                                   StatusBarStyle="{AppThemeBinding Light=DarkContent,Dark=LightContent}" />
        </ContentPage.Behaviors>

    <Grid IgnoreSafeArea="True">
                    <!-- GRADIENTE LIGHT -->
                <BoxView
                    IsEnabled="False"
                    InputTransparent="True"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    IsVisible="{AppThemeBinding Light=True, Dark=False}">

                    <BoxView.Background>
                        <RadialGradientBrush Center="0.82,0.12" Radius="0.85">
                            <GradientStop Color="#BFE3FF" Offset="0.0" />
                            <GradientStop Color="#EAF5FF" Offset="0.35" />
                            <GradientStop Color="#F4F8FC" Offset="1.0" />
                        </RadialGradientBrush>
                    </BoxView.Background>
                </BoxView>


                <!-- GRADIENTE DARK -->
                <BoxView
                    IsEnabled="False"
                    InputTransparent="True"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    IsVisible="{AppThemeBinding Light=False, Dark=True}">

                    <BoxView.Background>
                        <RadialGradientBrush Center="0.8,0.2" Radius="0.8">
                            <GradientStop Color="#2638BDF8" Offset="0.1" />
                            <GradientStop Color="#101E32" Offset="0.45" />
                            <GradientStop Color="#141414" Offset="1.0" />
                        </RadialGradientBrush>
                    </BoxView.Background>
            </BoxView>

        <Grid RowDefinitions="Auto, *, Auto" Padding="0,45,0,0">
            
            <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="25,10,25,5">
                <Label  Text="FEEDHUB"
                        TextColor="{AppThemeBinding Light={StaticResource FeedHubLightMainBlue}, Dark={StaticResource FeedHubDarkAccent}}"
                        FontSize="12" FontAttributes="Bold" CharacterSpacing="2"/>

                <Label  Text="Noticias por categoría"
                        TextColor="{AppThemeBinding
                        Light={StaticResource FeedHubLightTextPrimary},
                        Dark={StaticResource FeedHubDarkTextPrimary}}"  
                        FontSize="32" FontAttributes="Bold"/>
                <BoxView HeightRequest="3" 
                         BackgroundColor= "{AppThemeBinding Light={StaticResource FeedHubLightAccent}, Dark={StaticResource FeedHubDarkAccent}}"
                         WidthRequest="40" HorizontalOptions="Start" Margin="0,8,0,0"/>
            </VerticalStackLayout>

            
                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="12" Padding="25,15,25,20">
                        
                        <Border StrokeShape="RoundRectangle 18" 
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                        Dark={StaticResource FeedHubDarkCardBorder}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},
                        Dark={StaticResource FeedHubDarkCard}}"
                                 StrokeThickness="2">
                            <Grid>
                                <Grid ColumnDefinitions="32, *, Auto" Padding="15,12" InputTransparent="True">
                                    <Image Grid.Column="0" Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf57d;', Color=#38BDF8, Size=18}"/>
                                    <Label Grid.Column="1" Text="Internacional" Margin="12,0,0,0" VerticalOptions="Center" FontSize="15" FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary},
                                                      Dark={StaticResource FeedHubDarkTextPrimary}}"/>
                                    <Label Grid.Column="2" Text="&#xf105;" FontFamily="FontAwesome" TextColor="#475569" FontSize="18" VerticalOptions="Center"/>
                                </Grid>
                                <Button BackgroundColor="Transparent" Command="{Binding SelectCategoryCommand}" CommandParameter="Internacional"/>
                            </Grid>
                        </Border>

                        <Border StrokeShape="RoundRectangle 18" 
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                        Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},
                                        Dark={StaticResource FeedHubDarkCard}}"
                                StrokeThickness="2">
                            <Grid>
                                <Grid ColumnDefinitions="32, *, Auto" Padding="15,12" InputTransparent="True">
                                    <Image Grid.Column="0" Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf19c;', Color=#38BDF8, Size=18}"/>
                                    <Label Grid.Column="1" Text="Política" Margin="12,0,0,0" VerticalOptions="Center" FontSize="15" FontAttributes="Bold" 
                                                           TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary},
                                                                        Dark={StaticResource FeedHubDarkTextPrimary}}"/>
                                    <Label Grid.Column="2" Text="&#xf105;" FontFamily="FontAwesome" TextColor="#475569" FontSize="18" VerticalOptions="Center"/>
                                </Grid>
                                <Button BackgroundColor="Transparent" Command="{Binding SelectCategoryCommand}" CommandParameter="Politica"/>
                            </Grid>
                        </Border>

                        <Border StrokeShape="RoundRectangle 18"
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                        Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},
                        Dark={StaticResource FeedHubDarkCard}}"
                                StrokeThickness="2">
                            <Grid>
                                <Grid ColumnDefinitions="32, *, Auto" Padding="15,12" InputTransparent="True">
                                    <Image Grid.Column="0" Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf51e;', Color=#38BDF8, Size=18}"/>
                                    <Label Grid.Column="1" Text="Economía" Margin="12,0,0,0" VerticalOptions="Center" FontSize="15" FontAttributes="Bold" 
                                                           TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary},
                                                                        Dark={StaticResource FeedHubDarkTextPrimary}}"/>
                                    <Label Grid.Column="2" Text="&#xf105;" FontFamily="FontAwesome" TextColor="#475569" FontSize="18" VerticalOptions="Center"/>
                                </Grid>
                                <Button BackgroundColor="Transparent" Command="{Binding SelectCategoryCommand}" CommandParameter="Economia"/>
                            </Grid>
                        </Border>

                        <Border StrokeShape="RoundRectangle 18"
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                        Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},
                                                Dark={StaticResource FeedHubDarkCard}}"
                         StrokeThickness="2">
                            <Grid>
                                <Grid ColumnDefinitions="32, *, Auto" Padding="15,12" InputTransparent="True">
                                    <Image Grid.Column="0" Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf2db;', Color=#38BDF8, Size=18}"/>
                                    <Label Grid.Column="1" Text="Tecnología" Margin="12,0,0,0" VerticalOptions="Center" FontSize="15" FontAttributes="Bold" 
                                                           TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary},
                                                                        Dark={StaticResource FeedHubDarkTextPrimary}}"/>
                                    <Label Grid.Column="2" Text="&#xf105;" FontFamily="FontAwesome" TextColor="#475569" FontSize="18" VerticalOptions="Center"/>
                                </Grid>
                                <Button BackgroundColor="Transparent" Command="{Binding SelectCategoryCommand}" CommandParameter="Tecnologia"/>
                            </Grid>
                        </Border>

                        <Border StrokeShape="RoundRectangle 18" 
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                        Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},
                                        Dark={StaticResource FeedHubDarkCard}}"
                                StrokeThickness="2">
                            <Grid>
                                <Grid ColumnDefinitions="32, *, Auto" Padding="15,12" InputTransparent="True">
                                    <Image Grid.Column="0" Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf0c3;', Color=#38BDF8, Size=18}"/>
                                    <Label Grid.Column="1" Text="Ciencia" Margin="12,0,0,0" VerticalOptions="Center" FontSize="15" FontAttributes="Bold" 
                                                           TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary},
                                                                        Dark={StaticResource FeedHubDarkTextPrimary}}"/>
                                    <Label Grid.Column="2" Text="&#xf105;" FontFamily="FontAwesome" TextColor="#475569" FontSize="18" VerticalOptions="Center"/>
                                </Grid>
                                <Button BackgroundColor="Transparent" Command="{Binding SelectCategoryCommand}" CommandParameter="Ciencia"/>
                            </Grid>
                        </Border>

                        <Border StrokeShape="RoundRectangle 18" 
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                         Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},
                                                Dark={StaticResource FeedHubDarkCard}}"
                                StrokeThickness="2">
                            <Grid>
                                <Grid ColumnDefinitions="32, *, Auto" Padding="15,12" InputTransparent="True">
                                    <Image Grid.Column="0" Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf0c0;', Color=#38BDF8, Size=18}"/>
                                    <Label Grid.Column="1" Text="Sociedad" Margin="12,0,0,0" VerticalOptions="Center" FontSize="15" FontAttributes="Bold" 
                                                            TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary},
                                                                        Dark={StaticResource FeedHubDarkTextPrimary}}"/>
                                    <Label Grid.Column="2" Text="&#xf105;" FontFamily="FontAwesome" TextColor="#475569" FontSize="18" VerticalOptions="Center"/>
                                </Grid>
                                <Button BackgroundColor="Transparent" Command="{Binding SelectCategoryCommand}" CommandParameter="Sociedad"/>
                            </Grid>
                        </Border>

                        <Border StrokeShape="RoundRectangle 18"
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                        Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},
                                                Dark={StaticResource FeedHubDarkCard}}" StrokeThickness="2">
                            <Grid>
                                <Grid ColumnDefinitions="32, *, Auto" Padding="15,12" InputTransparent="True">
                                    <Image Grid.Column="0" Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf630;', Color=#38BDF8, Size=18}"/>
                                    <Label Grid.Column="1" Text="Cultura" Margin="12,0,0,0" VerticalOptions="Center" FontSize="15" FontAttributes="Bold"
                                                            TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary},
                                                                    Dark={StaticResource FeedHubDarkTextPrimary}}"/>
                                <Label Grid.Column="2" Text="&#xf105;" FontFamily="FontAwesome" TextColor="#475569" FontSize="18" VerticalOptions="Center"/>
                                </Grid>
                                <Button BackgroundColor="Transparent" Command="{Binding SelectCategoryCommand}" CommandParameter="Cultura"/>
                            </Grid>
                        </Border>

                        <Border StrokeShape="RoundRectangle 18" 
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                        Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},
                                        Dark={StaticResource FeedHubDarkCard}}"
                                StrokeThickness="2">
                            <Grid>
                                <Grid ColumnDefinitions="32, *, Auto" Padding="15,12" InputTransparent="True">
                                    <Image Grid.Column="0" Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf434;', Color=#38BDF8, Size=18}"/>
                                    <Label Grid.Column="1" Text="Deportes" Margin="12,0,0,0" VerticalOptions="Center" FontSize="15" FontAttributes="Bold"
                                                            TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary},
                                                                    Dark={StaticResource FeedHubDarkTextPrimary}}"/>
                                <Label Grid.Column="2" Text="&#xf105;" FontFamily="FontAwesome" TextColor="#475569" FontSize="18" VerticalOptions="Center"/>
                                </Grid>
                                <Button BackgroundColor="Transparent" Command="{Binding SelectCategoryCommand}" CommandParameter="Deportes"/>
                            </Grid>
                        </Border>

                        <Border StrokeShape="RoundRectangle 18" 
                                Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                        Dark={StaticResource FeedHubDarkCardBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},
                                        Dark={StaticResource FeedHubDarkCard}}" StrokeThickness="2">
                            <Grid>
                                <Grid ColumnDefinitions="32, *, Auto" Padding="15,12" InputTransparent="True">
                                    <Image Grid.Column="0" Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf11b;', Color=#38BDF8, Size=18}"/>
                                    <Label Grid.Column="1" Text="Entretenimiento" Margin="12,0,0,0" VerticalOptions="Center" FontSize="15" FontAttributes="Bold"
                                                            TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextPrimary},
                                                                    Dark={StaticResource FeedHubDarkTextPrimary}}"/>
                                <Label Grid.Column="2" Text="&#xf105;" FontFamily="FontAwesome" TextColor="#475569" FontSize="18" VerticalOptions="Center"/>
                                </Grid>
                                <Button BackgroundColor="Transparent" Command="{Binding SelectCategoryCommand}" CommandParameter="Entretenimiento"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <Border Grid.Row="2" Margin="25,10,25,50" HeightRequest="48" 
                        VerticalOptions="End"
                        StrokeShape="RoundRectangle 26" 
                        Stroke="{AppThemeBinding Light={StaticResource FeedHubLightCardBorder},
                                        Dark={StaticResource FeedHubDarkCardBorder}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource FeedHubLightCard2},
                                        Dark={StaticResource FeedHubDarkCard}}" 
                        StrokeThickness="2">
                        
                            <SearchBar Grid.Column="1"
                                    Placeholder="{Binding DynamicPlaceholder}"
                                    Text="{Binding SearchText}" 
                                    SearchCommand="{Binding SearchCommand}"
                                    PlaceholderColor="#64748B"
                                    TextColor="{AppThemeBinding Light={StaticResource FeedHubLightTextSecondary},
                                                Dark={StaticResource FeedHubDarkTextSecondary}}" 
                                    FontSize="14" 
                                    BackgroundColor="Transparent"/>
                        
                </Border>
                </Grid>
                </Grid>
</ContentPage>