<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeedHub_App.Views.News.CategoryListPage"
             Title="Categories">

    <CollectionView ItemsSource="{Binding Categories}">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" Span="2" 
                             HorizontalItemSpacing="15" VerticalItemSpacing="15" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border StrokeShape="RoundRectangle 20"
                        HeightRequest="120"
                        BackgroundColor="#F8F9FA"
                        Stroke="LightGray">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer 
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCategoryCommand}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="{Binding .}" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#333333" />

                        <BoxView HeightRequest="2" WidthRequest="30" 
                                 Color="#4a9eff" Margin="0,5" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>