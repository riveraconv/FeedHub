<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FeedHub_App.ViewModels.News"
             xmlns:models="clr-namespace:FeedHub_Core.Models;assembly=FeedHub_Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:utils="clr-namespace:FeedHub_App.Utilities"
             x:Class="FeedHub_App.Views.News.CategoryNewsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0F172A">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="Transparent" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- TEMPLATE NOTICIA -->
            <DataTemplate x:Key="NewsTemplate">
                <Border Stroke="#1E3A5A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Margin="10"
                        BackgroundColor="#1E293B">
                    <Grid RowDefinitions="200, Auto">
                        <Grid Grid.Row="0">
                            <BoxView BackgroundColor="#1E3A5A" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                            <Label Text="FeedHub"
                                   TextColor="#4DA8E8"
                                   FontSize="38"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Opacity="0.3"/>
                            <Image Source="{Binding ImageUrl}"
                                   HeightRequest="200"
                                   Aspect="AspectFill"
                                   IsVisible="{Binding ImageUrl, Converter={StaticResource NullToBoolConverter}}"/>
                            <BoxView VerticalOptions="End" HeightRequest="30">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#1E293B" Offset="1"/>
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>
                        </Grid>
                        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="10">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="19" TextColor="#F8FAFC" LineBreakMode="WordWrap"/>
                            <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="6">
                                <Label Grid.Column="0" Text="{Binding Source}" FontSize="12" TextColor="#38BDF8" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="•" TextColor="#475569"/>
                                <Label Grid.Column="2" Text="{Binding PublishDate, StringFormat='{0:dd MMM, HH:mm}'}" FontSize="12" TextColor="#94A3B8"/>
                            </Grid>
                            <Label Text="{Binding Description}" FontSize="14" TextColor="#94A3B8" LineBreakMode="TailTruncation" MaxLines="3"
                                   IsVisible="{Binding Description, Converter={StaticResource NullToBoolConverter}}"/>
                            <Label Text="Leer noticia completa →" TextColor="#38BDF8" FontSize="13" FontAttributes="Bold" HorizontalOptions="End" Margin="0,5,0,0"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- TEMPLATE ANUNCIO -->
            <DataTemplate x:Key="AdTemplate">
                <Border StrokeThickness="2" Stroke="#1E3A5A"
                        StrokeShape="RoundRectangle 20"
                        Margin="10"
                        BackgroundColor="#1E293B">
                    <Grid RowDefinitions="200, Auto">
                        <Grid Grid.Row="0" BackgroundColor="#0F172A">
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                                <Label Text="📢" FontSize="48" HorizontalOptions="Center"/>
                                <Label Text="ESPACIO PUBLICITARIO"
                                       TextColor="#38BDF8"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="2"
                                       HorizontalOptions="Center"/>
                                <Label Text="Aquí aparecerá tu anuncio"
                                       TextColor="#475569"
                                       FontSize="12"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="10">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border Grid.Column="0"
                                        BackgroundColor="#1E3A5A"
                                        StrokeShape="RoundRectangle 4"
                                        Padding="6,2"
                                        StrokeThickness="0">
                                    <Label Text="Anuncio" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                </Border>
                                <Label Grid.Column="1"
                                       Text="Contenido patrocinado"
                                       TextColor="#475569"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       Margin="8,0,0,0"/>
                            </Grid>
                            <Label Text="Tu anuncio aparecerá aquí"
                                   FontAttributes="Bold"
                                   FontSize="19"
                                   TextColor="#F8FAFC"
                                   LineBreakMode="WordWrap"
                                   Opacity="0.3"/>
                            <Label Text="Descripción del anuncio..."
                                   FontSize="14"
                                   TextColor="#94A3B8"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="3"
                                   Opacity="0.3"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- SELECTOR -->
            <utils:NewsTemplateSelector x:Key="NewsTemplateSelector"
                                        NewsTemplate="{StaticResource NewsTemplate}"
                                        AdTemplate="{StaticResource AdTemplate}"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <BoxView>
            <BoxView.Background>
                <RadialGradientBrush Center="0.8,0.2" Radius="0.7">
                    <GradientStop Color="#2638BDF8" Offset="0.1"/>
                    <GradientStop Color="#000F172A" Offset="0.8"/>
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto,*" Padding="0,45,0,0">

            <VerticalStackLayout Grid.Row="0" Padding="25,10,25,20" Spacing="4">
                <Label Text="FEEDHUB" TextColor="#38BDF8" FontSize="12" FontAttributes="Bold"/>
                <Label Text="{Binding PageTitle}" TextColor="#F8FAFC" FontSize="22" FontAttributes="Bold"/>
                <BoxView HeightRequest="3" WidthRequest="40" HorizontalOptions="Start" BackgroundColor="#38BDF8"/>
            </VerticalStackLayout>

            <Grid Grid.Row="1">

                <CollectionView ItemsSource="{Binding Articles}"
                                SelectionMode="Single"
                                SelectionChanged="OnSelectionChanged"
                                ItemTemplate="{StaticResource NewsTemplateSelector}">

                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="35,10,35,50" Spacing="0">
                            <Grid HeightRequest="50">
                                <Border IsVisible="{Binding CanLoadMore}"
                                        BackgroundColor="#334155"
                                        Stroke="#1E3A5A"
                                        StrokeShape="RoundRectangle 20"
                                        WidthRequest="200"
                                        HeightRequest="40">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsLoadingMore}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LoadMoreCommand}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                        <Image Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf103;', Color=#38BDF8, Size=16}" VerticalOptions="Center"/>
                                        <Label Text="Cargar más noticias" TextColor="#F8FAFC" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Image Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf103;', Color=#38BDF8, Size=16}" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                                <ActivityIndicator IsVisible="{Binding IsLoadingMore}"
                                                   IsRunning="{Binding IsLoadingMore}"
                                                   Color="#38BDF8"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   HeightRequest="30"
                                                   WidthRequest="30"/>
                            </Grid>
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>

                <!-- EMPTY -->
                <Grid IsVisible="{Binding NoResultsFound}" BackgroundColor="Transparent">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Margin="0,0,0,100">
                        <Label Text="🔎" FontSize="50" HorizontalTextAlignment="Center"/>
                        <Label Text="No se ha encontrado nada" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        <Label Text="Prueba con otra búsqueda" TextColor="#8A99A8" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- LOADING -->
                <Grid IsVisible="{Binding IsLoading}"
                      VerticalOptions="Center"
                      HorizontalOptions="Center"
                      TranslationY="-120">
                    <VerticalStackLayout HorizontalOptions="Fill" VerticalOptions="Fill" Padding="0,100,0,0" Spacing="15">
                        <ActivityIndicator IsRunning="{Binding IsLoading}" Color="#38BDF8" HorizontalOptions="Center" HeightRequest="50" WidthRequest="50"/>
                        <Label Text="Preparando noticias..." HorizontalTextAlignment="Center" TextColor="#94A3B8" FontSize="16"/>
                    </VerticalStackLayout>
                </Grid>

                <!--Error de conexion -->

                <!-- Error de conexión -->
                <Grid IsVisible="{Binding HasError}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    TranslationY="-80">

                    <BoxView BackgroundColor = "#CC0F172A"/>

                    <VerticalStackLayout
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Spacing="15"
                        Padding="40">

                        <Label Text="📡"
                            FontSize="50"
                            HorizontalTextAlignment="Center"/>

                        <Label Text="Sin conexión"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"/>

                        <Label Text="{Binding ErrorMessage}"
                            TextColor="#94A3B8"
                            FontSize="14"
                            HorizontalTextAlignment="Center"/>

                        <Button Text="Reintentar búsqueda"
                                Command="{Binding RetrySearchCommand}"
                                BackgroundColor="#1E3A5A"
                                TextColor="#38BDF8"
                                CornerRadius="20"
                                Margin="0,10,0,0"/>

                    </VerticalStackLayout>

                </Grid>

                <!-- Sin contenido por filtros -->
                <Grid IsVisible="{Binding IsContentEmpty}"
                      VerticalOptions="Center"
                      HorizontalOptions="Center"
                      TranslationY="-80">
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid"
                                     Binding="{Binding HasError}"
                                     Value ="true">
                                     <Setter Property="IsVisible"
                                        Value="False"/>
                        </DataTrigger>
                    </Grid.Triggers>
                    
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15" Padding="40">
                        <Label Text="⚙️" FontSize="50" HorizontalTextAlignment="Center"/>
                        <Label Text="No hay contenido disponible" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        <Label Text="Has filtrado todo el contenido. Ve a Ajustes para activar alguna categoría o fuente de noticias." TextColor="#94A3B8" FontSize="14" HorizontalTextAlignment="Center"/>
                        <Button Text="Ir a Ajustes" Command="{Binding GoToSettingsCommand}" BackgroundColor="#1E3A5A" TextColor="#38BDF8" CornerRadius="20" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>