<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FeedHub_App.ViewModels.News"
             xmlns:models="clr-namespace:FeedHub_Core.Models;assembly=FeedHub_Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodels:CategoryListViewModel"
             x:Class="FeedHub_App.Views.News.CategoryNewsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0F172A">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="Transparent"
                                   StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid>

        <!-- BACKGROUND -->
        <BoxView>
            <BoxView.Background>
                <RadialGradientBrush Center="0.8,0.2" Radius="0.7">
                    <GradientStop Color="#2638BDF8" Offset="0.1"/>
                    <GradientStop Color="#000F172A" Offset="0.8"/>
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- MAIN -->
        <Grid RowDefinitions="Auto,*" Padding="0,45,0,0">

            <!-- HEADER -->
            <VerticalStackLayout Grid.Row="0"
                                 Padding="25,10,25,20"
                                 Spacing="4">

                <Label Text="FEEDHUB"
                       TextColor="#38BDF8"
                       FontSize="12"
                       FontAttributes="Bold"/>

                <Label Text="{Binding PageTitle}"
                       TextColor="#F8FAFC"
                       FontSize="22"
                       FontAttributes="Bold"/>

                <BoxView HeightRequest="3"
                         WidthRequest="40"
                         HorizontalOptions="Start"
                         BackgroundColor="#38BDF8"/>
            </VerticalStackLayout>

            <!-- BODY -->
            <Grid Grid.Row="1">

                <!-- LIST -->
                <CollectionView ItemsSource="{Binding Articles}"
                                SelectionMode="Single"
                                SelectionChanged="OnSelectionChanged">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:NewsItem">

                            <Border Stroke="#1E3A5A"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 20"
                                    Margin="10"
                                    BackgroundColor="#1E293B">

                                <VerticalStackLayout>

                                    <!-- IMAGE TOP (CORRECTO) -->
                                    <Grid HeightRequest="180">

                                        <Image Source="{Binding ImageUrl}"
                                               Aspect="AspectFill"/>

                                        <!-- SCRIM PARA LEGIBILIDAD -->
                                        <BoxView VerticalOptions="End" HeightRequest="30">
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="Transparent" Offset="0"/>
                                                <GradientStop Color="#1E293B" Offset="1"/>
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>

                                    </Grid>

                                    <!-- CONTENT -->
                                    <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="10">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="19"
                                           TextColor="#F8FAFC"
                                           LineBreakMode="WordWrap"/>

                                    <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="6">
                                        <Label Grid.Column="0" Text="{Binding Source}" FontSize="12" TextColor="#38BDF8" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="•" TextColor="#475569"/>
                                        <Label Grid.Column="2" Text="{Binding PublishDate, StringFormat='{0:dd MMM, HH:mm}'}" FontSize="12" TextColor="#94A3B8"/>
                                    </Grid>

                                    <Label Text="{Binding Description}"
                                           FontSize="14"
                                           TextColor="#94A3B8"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="3"
                                           IsVisible="{Binding Description, Converter={StaticResource NullToBoolConverter}}"/>

                                    <Label Text="Leer noticia completa →" 
                                           TextColor="#38BDF8" 
                                           FontSize="13" 
                                           FontAttributes="Bold"
                                           HorizontalOptions="End" 
                                           Margin="0,5,0,0"/>
                                </VerticalStackLayout>

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- FOOTER -->
                    <CollectionView.Footer>

                        <VerticalStackLayout Padding="35,10,35,50" Spacing="0">
                            <Grid HeightRequest="50">

                            <Border IsVisible="{Binding CanLoadMore}"
                                    BackgroundColor="#334155"
                                    Stroke="#1E3A5A"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="200"
                                    HeightRequest="40">

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>

                                    <DataTrigger TargetType="Border" Binding="{Binding IsLoadingMore}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Border.Triggers>
                                
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LoadMoreCommand}" />
                                </Border.GestureRecognizers>

                                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                    <Image Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf103;', Color=#38BDF8, Size=16}" VerticalOptions="Center"/>
                                    <Label Text="Cargar más noticias" TextColor="#F8FAFC" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Image Source="{FontImage FontFamily=FontAwesome, Glyph='&#xf103;', Color=#38BDF8, Size=16}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                            <ActivityIndicator IsVisible="{Binding IsLoadingMore}"
                                               IsRunning="{Binding IsLoadingMore}"
                                               Color="#38BDF8"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               HeightRequest="30"
                                               WidthRequest="30"/>
                                               
                            </Grid>
                        </VerticalStackLayout>

                    </CollectionView.Footer>

                </CollectionView>

                <!-- EMPTY (SOLO UNO, SIN COMPETIR CON LOADING) -->
                <Grid IsVisible="{Binding NoResultsFound}"
                      BackgroundColor="Transparent">

                    <VerticalStackLayout VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="10"
                                         Margin="0,0,0,100">

                        <Label Text="🔎"
                               FontSize="50"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="No se ha encontrado nada"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="Prueba con otra búsqueda"
                               TextColor="#8A99A8"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>

                </Grid>

                <!-- LOADING (ÚNICO OVERLAY REAL) -->
                <VerticalStackLayout IsVisible="{Binding IsLoading}"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill"
                     Padding="0,100,0,0"
                     Spacing="15">
                    <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                    Color="#38BDF8" 
                                    HorizontalOptions="Center"
                                    HeightRequest="50"
                                    WidthRequest="50"/>
                    <Label Text="Preparando noticias..." 
                        HorizontalTextAlignment="Center" 
                        TextColor="#94A3B8" 
                        FontSize="16"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>