<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FeedHub_App.Views.News.CategoryNewsPage"
    Title="Explore by categories">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto"
          ColumnDefinitions="*"
          RowSpacing="10"
          ColumnSpacing="0">

        <!-- Primer label en la primera fila -->
        <Label 
            Text="📰 Primera fila"
            FontSize="24"
            TextColor="Black"
            Grid.Row="0"
            Grid.Column="0"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>

        <!-- Segundo label en la segunda fila -->
        <Label 
            Text="📚 Segunda fila"
            FontSize="24"
            TextColor="Black"
            BackgroundColor="#ffd0e8"
            Grid.Row="1"
            Grid.Column="0"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>

    </Grid>
</ContentPage>
